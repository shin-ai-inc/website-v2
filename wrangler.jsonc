{
  // shinai-inc.jp の静的配信(Cloudflare Workers の静的アセット)。配信は無料・回数無制限。
  // Pages ではなく Workers を使うのは、Pages が /about.html を /about へ転送し、止める設定が無いため。
  // canonical・サイトマップ・検索結果の URL はすべて .html なので、html_handling を none にして今の URL のまま返す。
  // ビルド: node _build/build.mjs   配信: npx wrangler deploy
  // チャットとフォームの API は別の Worker(api/wrangler.toml)で、ここには含めない。
  "name": "shinai-website",
  "compatibility_date": "2026-09-15",
  // 本番の URL は shinai-inc.jp だけにする。既定では *.workers.dev と
  // 版ごとのプレビューURL(例 abc123-shinai-website.〇〇.workers.dev)が公開され、
  // 同じ内容が別の URL でも読めてしまう(柴田判断 2026-09-16)。
  "workers_dev": false,
  "preview_urls": false,
  // 本番のドメイン。custom_domain で DNS と証明書を Cloudflare が作る(2026-10-10 に GitHub Pages から移行)。
  "routes": [{ "pattern": "shinai-inc.jp", "custom_domain": true }],
  // 配備の前に検査と組み立てを必ず走らせる。古い版から配備して本番の /hana/ を消した(2026-10-14)。
  "build": { "command": "node tools/predeploy-check.mjs && node _build/build.mjs" },
  // 映像の範囲指定(Range)だけ Worker で応える。静的配信は Range を扱わず、Safari が映像を再生せず、
  // Chrome は途中へ飛べなかった(2026-10-17 実測)。Worker を先に通すのは映像の置き場所だけで、
  // ほかの経路は静的配信のまま(無料・回数無制限の数え方を変えない)。
  "main": "worker/media.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/studio-mark/assets/*"],
    "html_handling": "none",
    // 無い URL は dist/404.html を返す(none だと本文 0 バイト)。single-page-application にはしない
    // (存在しない URL まで 200 になり、偽の 404 で検索の評価が濁る・2026-10-10 セキュリティ点検)。
    "not_found_handling": "404-page"
  }
}
